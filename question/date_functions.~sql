---Display department_id wise employee count and total salary, ordered by total salary descending.

select department_id , count(*),sum(salary)total_salary from hr.employees
group by department_id 
order by total_salary desc;


--Display department_id wise total salary including commission using NVL.

select department_id ,sum(salary)total_salary, nvl(commision_pct,1) from hr.employees
group by department_id ;


