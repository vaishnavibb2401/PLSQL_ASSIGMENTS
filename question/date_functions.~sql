--for practice 

--1 Extract the month from hire_date for all employees.
 
select hire_date,  extract(month from hire_date)from hr.employees;

--2 Extract the year from hire_date.

select hire_date, extract(year from hire_date)from hr.employees;

--3 Extract the day from hire_date.

select hire_date,extract(day from hire_date)from hr.employees;

-- 4 Display first_name, hire_date, and the month number of joining.

select first_name,hire_date, extract(month from hire_date )from hr.employees; 

-- 5 Display only the year of joining for employee EMPLOYEE_ID = 101.

select employee_id, extract(year from hire_date)emp_year from hr.employees
where employee_id ='101';

-- 6 display only day of joining  those who has salary is graeter than 2000 and its desc


select salary ,extract(day from hire_date)from hr.employees 
where salary >2000
order by salary desc ;

-- 7 Find employees who joined in the year 2005.

select hire_date  from hr.employees
where extract(year from hire_date)=2005;

--8 Get employees who joined in the month of June (any year).

select hire_date from hr.employees
where extract(month from hire_date)= 6 ;

-- 9 Count how many employees joined in each year.

select count(extract(year from hire_date))from hr.employees;


-- to_date ()

-- Convert the string '17-06-2005' into a DATE using TO_DATE.   

select to_date('17-06-2006','dd-mm-yy')from dual;

--Find employees who joined before 01-JAN-2008.

SELECT HIRE_DATE
FROM hr.employees
WHERE hire_date < TO_DATE('01-JAN-2008','DD-MON-YYYY');


